# --- Auth dashboard pusat (Tahap 4) ---
# WAJIB diganti string acak panjang sebelum deploy ke VPS — BEDA dari
# token cabang (branches.token_hash), ini menandatangani sesi login manusia.
JWT_SECRET=change-this-to-a-long-random-string-before-production
JWT_EXPIRES_IN=12h
# Opsional, default 5 & 15 kalau tidak diisi:
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15
